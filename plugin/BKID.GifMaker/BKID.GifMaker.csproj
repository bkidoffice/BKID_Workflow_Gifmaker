<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>BKID.GifMaker</AssemblyName>
    <RootNamespace>BKID.GifMaker</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyTitle>BKID GifMaker</AssemblyTitle>
    <Description>Linear part motion GIF capture with a native BKID toolbar.</Description>
    <Company>BKID</Company>
    <Product>BKID GifMaker</Product>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="RhinoCommon" Version="6.0.18016.23451" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="../../src/BKID_GifMaker.py" LogicalName="BKID.GifMaker.Capture.py" />
    <EmbeddedResource Include="../../assets/icon_64.png" LogicalName="BKID.GifMaker.Icon.png" />
    <EmbeddedResource Include="../../src/gif_writer.py" LogicalName="BKID.GifMaker.gif_writer.py" />
    <EmbeddedResource Include="Toolbar/BKID.GifMaker.rui" LogicalName="BKID.GifMaker.Toolbar.rui" />
  </ItemGroup>
</Project>
